# Independent demo. Synthetic data.
# Copy to .env and adjust as needed.

# Database
DATABASE_PATH=data/workbench.db

# Paths
UPLOAD_DIR=data/uploads
OUTPUT_DIR=outputs

# LLM — default is local Ollama (no API key, prompts stay on this machine)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:latest
OLLAMA_BASE_URL=http://localhost:11434

# Hosted providers (optional, explicit opt-in). Changing LLM_PROVIDER away from
# ollama sends prompts to a remote API. The UI shows a visible warning.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Schema version must match schema.sql
SCHEMA_VERSION=1
