# Construction Data Onboarding Workbench - backend configuration
# Independent demo. Synthetic data.
# Prefer the repo-root .env (copied from .env.example).

DATABASE_PATH=workbench.db
UPLOAD_DIR=data/uploads
OUTPUT_DIR=outputs

LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:latest
OLLAMA_BASE_URL=http://localhost:11434

